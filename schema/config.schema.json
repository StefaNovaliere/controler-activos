{
  "$defs": {
    "AssetSpec": {
      "additionalProperties": false,
      "description": "Un activo tal y como lo escribe el usuario: los overrides son opcionales.",
      "properties": {
        "cooldown_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cooldown Minutes"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "entry_price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Price"
        },
        "exits": {
          "items": {
            "$ref": "#/$defs/ExitSpec"
          },
          "maxItems": 8,
          "title": "Exits",
          "type": "array"
        },
        "fallback": {
          "anyOf": [
            {
              "$ref": "#/$defs/FallbackSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "first_run_policy": {
          "anyOf": [
            {
              "enum": [
                "none",
                "summary",
                "full"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Run Policy"
        },
        "hysteresis_pct": {
          "anyOf": [
            {
              "maximum": 50.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hysteresis Pct"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "max_staleness_minutes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Staleness Minutes"
        },
        "notify_on_return": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notify On Return"
        },
        "notify_transient": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notify Transient"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "renotify_while_outside": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Renotify While Outside"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "trailing": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrailingSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        }
      },
      "required": [
        "id",
        "provider",
        "symbol"
      ],
      "title": "AssetSpec",
      "type": "object"
    },
    "Defaults": {
      "additionalProperties": false,
      "properties": {
        "cooldown_minutes": {
          "default": 180,
          "minimum": 0,
          "title": "Cooldown Minutes",
          "type": "integer"
        },
        "currency": {
          "default": "usd",
          "title": "Currency",
          "type": "string"
        },
        "first_run_policy": {
          "default": "summary",
          "enum": [
            "none",
            "summary",
            "full"
          ],
          "title": "First Run Policy",
          "type": "string"
        },
        "hysteresis_pct": {
          "anyOf": [
            {
              "maximum": 50.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.25",
          "title": "Hysteresis Pct"
        },
        "max_staleness_minutes": {
          "default": 240,
          "minimum": 1,
          "title": "Max Staleness Minutes",
          "type": "integer"
        },
        "notify_on_return": {
          "default": true,
          "title": "Notify On Return",
          "type": "boolean"
        },
        "notify_transient": {
          "default": false,
          "title": "Notify Transient",
          "type": "boolean"
        },
        "renotify_while_outside": {
          "default": false,
          "title": "Renotify While Outside",
          "type": "boolean"
        }
      },
      "title": "Defaults",
      "type": "object"
    },
    "ExitSpec": {
      "additionalProperties": false,
      "description": "Un tramo del plan de salida: a este precio, vendo esta parte.\n\nEl bot no ejecuta nada —no toca tu dinero ni tiene por qué poder hacerlo—:\navisa. Pero el aviso lleva la fracción escrita porque el valor del plan está\nen haberlo decidido antes, no en recordarlo en caliente.",
      "properties": {
        "note": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Price"
        },
        "sell_pct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sell Pct"
        }
      },
      "required": [
        "price"
      ],
      "title": "ExitSpec",
      "type": "object"
    },
    "FallbackSpec": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "symbol"
      ],
      "title": "FallbackSpec",
      "type": "object"
    },
    "NotifierSettings": {
      "additionalProperties": false,
      "properties": {
        "telegram": {
          "anyOf": [
            {
              "$ref": "#/$defs/TelegramSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "NotifierSettings",
      "type": "object"
    },
    "ProviderSettings": {
      "additionalProperties": false,
      "properties": {
        "api_key_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key Env"
        },
        "batch_size": {
          "default": 8,
          "maximum": 120,
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 15.0,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "title": "ProviderSettings",
      "type": "object"
    },
    "TelegramSettings": {
      "additionalProperties": false,
      "properties": {
        "chat_id_env": {
          "default": "TELEGRAM_CHAT_ID",
          "title": "Chat Id Env",
          "type": "string"
        },
        "parse_mode": {
          "const": "HTML",
          "default": "HTML",
          "title": "Parse Mode",
          "type": "string"
        },
        "token_env": {
          "default": "TELEGRAM_BOT_TOKEN",
          "title": "Token Env",
          "type": "string"
        }
      },
      "title": "TelegramSettings",
      "type": "object"
    },
    "TrailingSpec": {
      "additionalProperties": false,
      "description": "Aviso relativo a un extremo, no a un precio fijo.\n\nUn umbral fijo contesta «¿llegó a este precio?». Esto contesta «¿se dio la\nvuelta?», que es otra pregunta y la que de verdad corresponde a vender alto\ny comprar barato: no hay que acertar el techo, solo decidir cuánto se está\ndispuesto a devolver desde él.\n\nAdemás no hay que reajustarlo: un porcentaje sobre el máximo vale igual a\n0,07 que a 7, mientras que un umbral fijo se queda obsoleto en cuanto el\nactivo cambia de orden de magnitud.",
      "properties": {
        "drop_pct": {
          "anyOf": [
            {
              "exclusiveMaximum": 100.0,
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drop Pct"
        },
        "rise_pct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rise Pct"
        }
      },
      "title": "TrailingSpec",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/AssetSpec"
      },
      "title": "Assets",
      "type": "array"
    },
    "defaults": {
      "$ref": "#/$defs/Defaults"
    },
    "notifier": {
      "$ref": "#/$defs/NotifierSettings"
    },
    "providers": {
      "additionalProperties": {
        "$ref": "#/$defs/ProviderSettings"
      },
      "title": "Providers",
      "type": "object"
    },
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "assets"
  ],
  "title": "ConfigSpec",
  "type": "object"
}
